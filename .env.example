# Copy this file to ".env" and fill in the values. Never share or upload your real .env file.
PORT=3000

# Admin password used the FIRST time the server starts (you can change it later in Admin > Settings).
# Leave empty and a random password will be printed in the console.
ADMIN_PASSWORD=

# Email notifications (optional but recommended). Example for Gmail:
#   1. Turn on 2-Step Verification for the Gmail account
#   2. Create an "App password" at https://myaccount.google.com/apppasswords
#   3. Put it below as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deeptechtech@gmail.com
SMTP_PASS=
MAIL_FROM=DeepTech Website <deeptechtech@gmail.com>
MAIL_TO=deeptechtech@gmail.com

# Set to 1 when running behind a proxy/host that terminates HTTPS (Render, Railway, Nginx, ...)
TRUST_PROXY=
